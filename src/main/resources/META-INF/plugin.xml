<idea-plugin>
    <id>com.caixht.coach</id>
    <name>Java 报错教练</name>
    <vendor>caixht</vendor>

    <description>
        把一段 Java 报错翻译成初学者能懂的话：是什么、在哪、下一步想什么。
    </description>

    <depends>com.intellij.modules.platform</depends>
    <actions>
        <action id="Coach.ExplainSelection"
                class="com.caixht.coach.action.ExplainSelectionAction"
                text="解释选中的报错">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="first"/>
        </action>
    </actions>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Coach"
                    anchor="right"
                    secondary="true"
                    factoryClass="com.caixht.coach.ui.CoachToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"/>
    </extensions>
</idea-plugin>
